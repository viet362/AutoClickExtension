{
  "manifest_version": 3,
  "name": "AutoFlow - Macro & Excel Web Automator",
  "version": "1.0.0",
  "description": "Tự động ghi nhớ kịch bản click chuột, gõ phím và lặp dữ liệu từ file Excel trên trình duyệt hoàn toàn không cần quyền Admin.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoFlow Automator",
    "default_icon": {
      "16": "assets/icon_16.png",
      "48": "assets/icon_48.png",
      "128": "assets/icon_128.png"
    }
  },
  "icons": {
    "16": "assets/icon_16.png",
    "48": "assets/icon_48.png",
    "128": "assets/icon_128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
